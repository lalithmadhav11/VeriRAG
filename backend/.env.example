# --- SERVER CONFIG ---
NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173

# --- DATABASE / QUEUE ---
MONGODB_URI=mongodb://localhost:27017/verirag
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=rag_firewall_docs_gemini_cosine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- AI / LLM ---
# REQUIRED: Google Gemini key for embeddings and generation
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-2
MAX_CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- QUEUE CONFIG ---
JOB_MAX_ATTEMPTS=4

# --- INTEGRATIONS (OPTIONAL) ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
